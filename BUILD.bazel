exports_files([
    "versions.json",
    "Tellomi/version",
])

# The size set, not AppIcon.icon. This rules_apple pin rejects an .appiconset next to an
# Icon Composer .icon, and the .icon compile does not emit the iPad 152 and 167 pixel icons
# App Store still checks. AppIcon.icon stays in the tree as the glyph source.
filegroup(
    name = "TellomiAppIcon",
    srcs = glob(["Tellomi/Brand/AppIcon.xcassets/**"]),
    visibility = ["//visibility:public"],
)

# Same filenames as the upstream *.alticon slots, with the traced Tellomi logo.
[
    filegroup(
        name = "TellomiAlternate_{}".format(name),
        srcs = glob(["Tellomi/Brand/Alternates/{}.alticon/*.png".format(name)]),
        visibility = ["//visibility:public"],
    ) for name in [
        "BlackIcon",
        "BlackClassicIcon",
        "BlackFilledIcon",
        "BlueIcon",
        "BlueClassicIcon",
        "BlueFilledIcon",
        "WhiteFilledIcon",
        "New1",
        "New2",
        "Premium",
        "PremiumBlack",
        "PremiumTurbo",
    ]
]
